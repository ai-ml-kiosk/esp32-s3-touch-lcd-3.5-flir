{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PlatformIO: Build (no proxy)",
      "type": "shell",
      "command": "env",
      "args": [
        "-u",
        "HTTP_PROXY",
        "-u",
        "HTTPS_PROXY",
        "-u",
        "http_proxy",
        "-u",
        "https_proxy",
        "-u",
        "ALL_PROXY",
        "-u",
        "all_proxy",
        "pio",
        "run"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "PlatformIO: Upload (no proxy)",
      "type": "shell",
      "command": "env",
      "args": [
        "-u",
        "HTTP_PROXY",
        "-u",
        "HTTPS_PROXY",
        "-u",
        "http_proxy",
        "-u",
        "https_proxy",
        "-u",
        "ALL_PROXY",
        "-u",
        "all_proxy",
        "pio",
        "run",
        "--target",
        "upload"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "PlatformIO: Monitor",
      "type": "shell",
      "command": "pio",
      "args": [
        "device",
        "monitor"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
